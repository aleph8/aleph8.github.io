---
import '../styles/global.css';
import { defaultLocale, useTranslations } from '../i18n/utils';
import { getImage } from 'astro:assets';
import defaultOgImageSrc from '../assets/projects/vt4ai.jpg';

interface Props {
  title: string;
  description?: string;
  ogImage?: string | any;
  lang?: string;
  alternatePath?: string | null;
  wide?: boolean;
  contentPage?: boolean;
}

const {
  title,
  description = "Alejandro García Peláez - AI, cybersecurity, software.",
  ogImage,
  lang = defaultLocale,
  alternatePath: providedAlternatePath,
  wide = false,
  contentPage = false,
} = Astro.props;

const t = useTranslations(lang as any);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Optimize the OG image
const optimizedOgImage = await getImage({
  src: ogImage || defaultOgImageSrc,
  width: 1200,
  height: 630,
  format: 'jpg',
  quality: 90,   // Increased quality for better clarity
});

const resolvedOgImage = new URL(optimizedOgImage.src, Astro.site).toString();
const ogWidth = optimizedOgImage.attributes.width?.toString();
const ogHeight = optimizedOgImage.attributes.height?.toString();

const alternateLang = lang === 'es' ? 'en' : 'es';
const pathWithoutEnglishPrefix = Astro.url.pathname.replace(/^(?:\/en)+(?=\/|$)/, '') || '/';
const localizedPath = (path: string, locale: 'es' | 'en') => {
  const routePairs: Array<[string, string]> = [
    ['/microensayos', '/microessays'],
    ['/preguntas', '/questions'],
  ];
  let result = path;
  for (const [spanishRoute, englishRoute] of routePairs) {
    const source = locale === 'en' ? spanishRoute : englishRoute;
    const target = locale === 'en' ? englishRoute : spanishRoute;
    result = result.replace(new RegExp(`^${source}(?=/|$)`), target);
  }
  return locale === 'en' ? `/en${result === '/' ? '' : result}` : result;
};
const alternatePath = providedAlternatePath === null ? null : providedAlternatePath ?? (lang === 'en'
  ? localizedPath(pathWithoutEnglishPrefix, 'es')
  : localizedPath(pathWithoutEnglishPrefix, 'en'));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} - AGP</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {alternatePath && <link rel="alternate" hreflang={alternateLang} href={new URL(alternatePath, Astro.site)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="AGP Blog" href="/rss.xml" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    {resolvedOgImage && (
      <>
        <meta property="og:image" content={resolvedOgImage} />
        <meta property="og:image:secure_url" content={resolvedOgImage} />
        <meta property="og:image:type" content="image/jpeg" />
        {ogWidth && <meta property="og:image:width" content={ogWidth} />}
        {ogHeight && <meta property="og:image:height" content={ogHeight} />}
      </>
    )}
    <meta property="og:title" content={`${title} - AGP`} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="AGP" />
    {resolvedOgImage && <meta itemprop="image" content={resolvedOgImage} />}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={`${title} - AGP`} />
    <meta property="twitter:description" content={description} />
    {resolvedOgImage && <meta property="twitter:image" content={resolvedOgImage} />}

  </head>

  <body class="min-h-screen flex flex-col" style="color-scheme: light; color: black;">

    <!-- Nav -->
    <header id="site-header" class="py-6 px-6 md:px-12 fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-sm transition-transform duration-300">
      <nav aria-label="Main" class="max-w-3xl mx-auto flex items-center justify-between">
        <a href={lang === 'es' ? '/' : '/en/'} class="hover:opacity-80 transition-opacity duration-150">
          <img src="/img/logo.svg" alt="AGP" class="h-5 w-auto" />
        </a>
        <ul class="flex items-center gap-6 text-sm text-neutral-500">
          <li><a href={lang === 'es' ? '/blog' : '/en/blog'} class="hover:text-black transition-colors duration-150">{t('nav.writing')}</a></li>
          <li><a href={lang === 'es' ? '/microensayos' : '/en/microessays'} class="hover:text-black transition-colors duration-150">{t('nav.reflections')}</a></li>
          <li><a href={lang === 'es' ? '/projects' : '/en/projects'} class="hover:text-black transition-colors duration-150">{t('nav.projects')}</a></li>
          <li class="hidden sm:block"><a href={lang === 'es' ? '/about' : '/en/about'} class="hover:text-black transition-colors duration-150">{t('nav.about')}</a></li>
          <li class="inline-flex items-center gap-1 text-xs font-mono tracking-widest">
            {lang === 'en' ? (
              <span class="text-black" aria-current="true">EN</span>
            ) : alternatePath ? (
              <a href={alternatePath} lang="en" hreflang="en" class="text-neutral-500 hover:text-black transition-colors duration-150">EN</a>
            ) : (
              <span class="text-neutral-300" aria-disabled="true">EN</span>
            )}
            <span class="text-neutral-300 select-none" aria-hidden="true">/</span>
            {lang === 'es' ? (
              <span class="text-black" aria-current="true">ES</span>
            ) : alternatePath ? (
              <a href={alternatePath} lang="es" hreflang="es" class="text-neutral-500 hover:text-black transition-colors duration-150">ES</a>
            ) : (
              <span class="text-neutral-300" aria-disabled="true">ES</span>
            )}
          </li>
        </ul>
      </nav>
    </header>

    <!-- Main -->
    <main class:list={[
      "flex-grow w-full mx-auto px-6 md:px-12 pb-16 pt-24",
      wide ? "max-w-5xl" : "max-w-3xl",
      contentPage ? "content-page" : "",
    ]}>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="py-8 px-6 md:px-12">
      <div class="max-w-3xl mx-auto flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <p class="text-xs text-neutral-500">
          &copy; {new Date().getFullYear()} {t('footer.rights')}
        </p>
        <div class="flex flex-wrap items-center gap-6 text-xs text-neutral-500">
          <a href={lang === 'es' ? '/graph' : '/en/graph'} class="hover:text-black transition-colors duration-150">Graph</a>
          <a href="/rss.xml" class="hover:text-black transition-colors duration-150">RSS</a>
          <a href="https://github.com/aleph8" target="_blank" rel="noopener noreferrer" class="hover:text-black transition-colors duration-150">GitHub</a>
          <a href="https://x.com/alegpmbt" target="_blank" rel="noopener noreferrer" class="hover:text-black transition-colors duration-150">X</a>
          <a href="https://es.linkedin.com/in/alegpwk" target="_blank" rel="noopener noreferrer" class="hover:text-black transition-colors duration-150">LinkedIn</a>
        </div>
      </div>
    </footer>

    <!-- Mermaid: render code blocks with class language-mermaid -->
    <script type="module">
      import mermaid from 'mermaid';
      let supportsConstructableStyleSheets = false;
      try {
        const sheet = new CSSStyleSheet();
        sheet.insertRule(':root {}');
        supportsConstructableStyleSheets = true;
      } catch {
        // Mermaid 11 uses constructable stylesheets even in browsers that do
        // not expose them yet (notably older WebKit builds).
      }
      if (!supportsConstructableStyleSheets) {
        class MermaidStyleSheet {
          cssRules: Array<{ cssText: string }> = [];
          insertRule(rule: string) {
            this.cssRules.push({ cssText: rule });
            return this.cssRules.length - 1;
          }
        }
        Object.defineProperty(globalThis, 'CSSStyleSheet', { configurable: true, value: MermaidStyleSheet });
      }
      mermaid.initialize({
        startOnLoad: false,
        theme: 'neutral',
        suppressErrorRendering: true,
        fontFamily: 'Inter, system-ui, sans-serif',
        themeVariables: {
          primaryColor: '#f5f5f5',
          primaryBorderColor: '#e5e5e5',
          primaryTextColor: '#000000',
          lineColor: '#a3a3a3',
          edgeLabelBackground: '#ffffff',
        },
      });

      const renderDiagrams = async () => {
        let diagramIndex = 0;
        for (const code of document.querySelectorAll<HTMLElement>('pre code.language-mermaid')) {
          const pre = code.parentElement;
          if (!pre) continue;
          const container = document.createElement('div');
          container.className = 'mermaid-diagram my-8';
          const definition = code.textContent?.trim() || '';
          const id = `mermaid-${diagramIndex++}`;
          try {
            const { svg, bindFunctions } = await mermaid.render(id, definition);
            container.innerHTML = svg;
            pre.replaceWith(container);
            bindFunctions?.(container);
          } catch (error) {
            console.error(`Could not render Mermaid diagram ${id}:`, error);
          }
        }
      };
      void renderDiagrams();
    </script>

    <script is:inline>
      (function () {
        const header = document.getElementById('site-header');
        let lastY = window.scrollY;
        let ticking = false;

        window.addEventListener('scroll', function () {
          if (!ticking) {
            window.requestAnimationFrame(function () {
              const currentY = window.scrollY;
              if (currentY <= 0) {
                header.style.transform = 'translateY(0)';
              } else if (currentY > lastY) {
                // scrolling down - hide
                header.style.transform = 'translateY(-100%)';
              } else {
                // scrolling up - show
                header.style.transform = 'translateY(0)';
              }
              lastY = currentY;
              ticking = false;
            });
            ticking = true;
          }
        }, { passive: true });
      })();
    </script>

  </body>
</html>
