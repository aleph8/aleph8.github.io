---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { loadWritingGraph, relationsFor, writingUrl } from '../../lib/writings';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const showDrafts = import.meta.env.ALEPH_PREVIEW_DRAFTS === '1';
  const esPosts = posts.filter(p => p.id.startsWith('es/') && (showDrafts || !p.data.draft));
  return esPosts.map(post => {
    const slug = post.id.split('/').slice(1).join('/').replace(/\.mdx?$/, '');
    const translation = post.data.translationKey
      ? posts.find(candidate => candidate.id.startsWith('en/') && candidate.data.translationKey === post.data.translationKey && (showDrafts || !candidate.data.draft))
      : undefined;
    const alternatePath = translation ? writingUrl(translation) : null;
    return {
      params: { slug },
      props: { post, alternatePath },
    };
  });
}

const { post, alternatePath } = Astro.props;
if (post.data.type !== 'article') return Astro.redirect(writingUrl(post), 301);
const graph = await loadWritingGraph(import.meta.env.ALEPH_PREVIEW_DRAFTS === '1');
const relations = relationsFor(post, graph);
const { Content } = await render(post);
---

<PostLayout frontmatter={post.data} writing={post} relations={relations} lang="es" alternatePath={alternatePath}>
  <Content />
</PostLayout>
