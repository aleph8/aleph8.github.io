---
interface Props { lang?: 'es' | 'en' }
const { lang = 'es' } = Astro.props;
---

<div class="launch not-prose">
  <a href={lang === 'es' ? '/lifelike' : '/en/lifelike'}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5" />
    </svg>
    {lang === 'es' ? 'Abrir simulación a pantalla completa' : 'Open full-screen simulation'}
    <span aria-hidden="true">→</span>
  </a>
</div>

<style>
  .launch { display: flex; justify-content: center; margin: 1.5rem 0; }
  a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .65rem;
    min-height: 44px;
    padding: .75rem 1rem;
    border: 1px solid #d4d4d4;
    border-radius: .25rem;
    color: #262626;
    background: white;
    font-size: .875rem;
    font-weight: 500;
    text-decoration: none;
    text-align: center;
    transition: border-color .15s, color .15s;
  }
  a:hover { border-color: #667eea; color: #667eea; }
  a:focus-visible { outline: 2px solid #667eea; outline-offset: 4px; }
  svg, span { flex-shrink: 0; }
  @media (max-width: 480px) { a { width: 100%; } }
</style>
