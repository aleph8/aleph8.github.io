---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n/utils';
import {
  conceptKey,
  excerptFor,
  loadWritingGraph,
  localizedWritings,
  questionStatus,
  readingMinutes,
  writingUrl,
  type Locale,
  type WritingType,
} from '../lib/writings';

interface Props { lang: Locale; view: Extract<WritingType, 'microessay' | 'question'> }
const { lang, view } = Astro.props;
const t = useTranslations(lang);
const showDrafts = import.meta.env.ALEPH_PREVIEW_DRAFTS === '1';
const writings = await localizedWritings(lang, view, showDrafts);
const graph = await loadWritingGraph(showDrafts);
const essaysPath = lang === 'es' ? '/microensayos' : '/en/microessays';
const questionsPath = lang === 'es' ? '/preguntas' : '/en/questions';
const statusCopy = lang === 'es'
  ? { open: 'Abierta', 'in-progress': 'En investigación', answered: 'Respondida' }
  : { open: 'Open', 'in-progress': 'Under investigation', answered: 'Answered' };
---

<BaseLayout title={view === 'microessay' ? t('reflections.title') : t('reflections.questions')} description={t('reflections.description')} lang={lang} contentPage={true}>
  <div class="pt-6 md:pt-12 pb-16">
    <header class="mb-8 md:mb-12">
      <h1 class="text-2xl md:text-3xl font-semibold tracking-tight mb-2">{t('reflections.title')}</h1>
      <p class="text-neutral-500 text-base">{t('reflections.description')}</p>
      <nav class="reflection-tabs" aria-label={t('reflections.title')}>
        <a href={essaysPath} aria-current={view === 'microessay' ? 'page' : undefined}>{t('reflections.essays')}</a>
        <a href={questionsPath} aria-current={view === 'question' ? 'page' : undefined}>{t('reflections.questions')}</a>
      </nav>
    </header>

    <div class:list={['reflection-list', view === 'question' && 'question-list']}>
      {writings.map(writing => (
        <article class="reflection-card">
          <a href={writingUrl(writing)}>
            {view === 'microessay' && writing.data.image && (
              <Image src={writing.data.image} alt="" width={400} height={600} format="webp" class="book-cover" loading="lazy" />
            )}
            {view === 'microessay' && !writing.data.image && <div class="book-cover typographic-cover" aria-hidden="true">A</div>}
            <div class="reflection-copy">
              <div class="reflection-meta">
                <time datetime={writing.data.pubDate.toISOString()}>{writing.data.pubDate.toLocaleDateString(lang, { year: 'numeric', month: 'long', day: 'numeric' })}</time>
                {view === 'microessay' && <span>{readingMinutes(writing)} min</span>}
                {view === 'question' && <span class={`question-status ${questionStatus(conceptKey(writing), graph)}`}>{statusCopy[questionStatus(conceptKey(writing), graph)]}</span>}
              </div>
              <h2>{writing.data.title}</h2>
              <p>{excerptFor(writing)}</p>
              {writing.data.draft && <small>BORRADOR</small>}
            </div>
          </a>
        </article>
      ))}
    </div>

    {writings.length === 0 && <p class="text-neutral-500 text-sm">{view === 'microessay' ? t('reflections.no_essays') : t('reflections.no_questions')}</p>}
  </div>
</BaseLayout>

<style>
  .reflection-tabs { display: flex; gap: 1.5rem; margin-top: 2rem; border-bottom: 1px solid #e5e5e5; }
  .reflection-tabs a { padding: 0 0 .7rem; color: #737373; font: .72rem 'JetBrains Mono', monospace; letter-spacing: .12em; text-decoration: none; text-transform: uppercase; }
  .reflection-tabs a[aria-current='page'] { color: var(--color-accent); border-bottom: 2px solid var(--color-accent); }
  .reflection-list { display: grid; gap: 1.25rem; }
  .reflection-card { border-bottom: 1px solid #e5e5e5; padding-bottom: 1.25rem; }
  .reflection-card > a { display: grid; grid-template-columns: 92px minmax(0, 1fr); gap: 1.4rem; color: inherit; text-decoration: none; }
  .book-cover { width: 92px; aspect-ratio: 2 / 3; object-fit: cover; border: 1px solid #e5e5e5; box-shadow: 5px 7px 18px rgb(0 0 0 / .08); }
  .typographic-cover { display: grid; place-items: center; color: white; background: #151515; font: 2rem Georgia, serif; }
  .reflection-meta { display: flex; flex-wrap: wrap; gap: .8rem; color: #737373; font: .65rem 'JetBrains Mono', monospace; letter-spacing: .08em; text-transform: uppercase; }
  .reflection-copy h2 { margin: .55rem 0; font-size: 1.15rem; font-weight: 600; line-height: 1.35; }
  .reflection-copy p { color: #737373; font-size: .88rem; line-height: 1.6; }
  .reflection-copy small { color: var(--color-accent); font: .62rem 'JetBrains Mono', monospace; }
  .reflection-card a:hover h2 { color: var(--color-accent); }
  .question-list .reflection-card > a { grid-template-columns: 1fr; }
  .question-status.open { color: #737373; }
  .question-status.in-progress { color: #b7791f; }
  .question-status.answered { color: #24855f; }
  @media (min-width: 640px) { .reflection-card > a { grid-template-columns: 120px minmax(0, 1fr); } .book-cover { width: 120px; } }
</style>
